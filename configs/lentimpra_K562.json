{
  "_comment": [
    "LentiMPRA K562. Training hyperparameters only.",
    "The dataset file and the reporter construct are not config: pass --input_tsv and let",
    "train_lentimpra.py build LentiMPRAAgarwal2025Library.construct(), or override it with",
    "--construct_prefix / --construct_suffix / --construct_length / --no-construct."
  ],
  "data": {
    "batch_size": 32,
    "reverse_complement": true,
    "rc_prob": 0.5,
    "random_shift": true,
    "shift_prob": 0.5,
    "max_shift": 15,
    "subset_frac": 1.0,
    "num_workers": 4,
    "pin_memory": true
  },
  "head": {
    "pooling_type": "flatten",
    "hidden_sizes": [1024],
    "activation": "relu"
  },
  "optim": {
    "optimizer": "adam",
    "weight_decay": 1e-06,
    "gradient_accumulation_steps": 1,
    "gradient_clip": null
  },
  "stage1": {
    "num_epochs": 100,
    "early_stopping_patience": 5,
    "val_evals_per_epoch": 4,
    "head_lr": 1e-03,
    "dropout": 0.1,
    "lr_scheduler": "constant",
    "plateau_factor": 0.5,
    "plateau_patience": 2,
    "plateau_min_lr": 0.0
  },
  "stage2": {
    "num_epochs": 50,
    "early_stopping_patience": 5,
    "val_evals_per_epoch": 4,
    "head_lr": 1e-05,
    "encoder_lr": 1e-05,
    "dropout": 0.1,
    "lr_scheduler": "constant",
    "plateau_factor": 0.5,
    "plateau_patience": 2,
    "plateau_min_lr": 0.0
  },
  "checkpoint": {
    "pretrained_weights": null,
    "checkpoint_dir": "./results/mpra_K562",
    "save_mode": "minimal"
  },
  "logging": {
    "use_wandb": true,
    "wandb_project": "alphagenome-mpra",
    "wandb_name": "mpra-K562"
  },
  "runtime": {
    "device": null,
    "use_amp": false,
    "seed": 42
  }
}
